{
  "name": "lumensolar",
  "version": "0.5.0",
  "description": "Dimensionamento e proposta comercial fotovoltaica — Lumen Soluções",
  "author": "Lumen Soluções Ltda",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "npm run build && xvfb-run -a node scripts/smoke_test.mjs --full",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "dist:win:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.lumensolar.app",
    "productName": "LumenSolar",
    "copyright": "Copyright © 2025 LUMEN SOLUÇÕES LTDA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/.pnpm/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "extraMetadata": {
      "main": "dist-electron/index.js"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-${version}-instalador.${ext}"
    },
    "extraResources": []
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^31.3.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.0.5"
  }
}
